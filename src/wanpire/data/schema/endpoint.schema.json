{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ysern/wanpire/blob/main/src/wanpire/data/schema/endpoint.schema.json",
  "title": "wanpire endpoint preset",
  "description": "A place and its access channels. A link is made from two of these: the near end (where the device under test is) and the far end. Every figure names its source.",
  "type": "object",
  "required": ["schema", "id", "name", "location", "default_channel", "channels"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "wanpire-endpoint/1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Short name used on the command line, e.g. london"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "location": {
      "type": "object",
      "required": ["lat", "lon", "country", "region"],
      "additionalProperties": false,
      "properties": {
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180},
        "country": {"type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2"},
        "region": {
          "description": "World region, which picks the formula's route factor",
          "enum": ["north-america", "south-america", "europe", "middle-east", "africa", "south-asia", "southeast-asia", "east-asia", "oceania"]
        }
      }
    },
    "default_channel": {"type": "string", "description": "A key of channels, used when none is asked for"},
    "channels": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/channel"}
    },
    "paths": {
      "type": "object",
      "description": "Measured paths to other endpoints, by their id. Used before the table and the formula. Only figures whose licence allows redistribution.",
      "additionalProperties": {
        "type": "object",
        "required": ["rtt_ms", "source"],
        "properties": {
          "rtt_ms": {"type": "number", "exclusiveMinimum": 0, "maximum": 2000},
          "source": {"$ref": "#/$defs/source"}
        }
      }
    }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "required": ["kind", "description", "down", "up", "sources"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["generic", "media-private-network", "enterprise-fibre", "business-fibre", "consumer-fibre", "cable", "dsl", "fixed-wireless", "mobile-4g", "mobile-5g", "satellite-leo", "satellite-geo"]
        },
        "description": {"type": "string"},
        "down": {"$ref": "#/$defs/figures", "description": "Towards the endpoint (its download)"},
        "up": {"$ref": "#/$defs/figures", "description": "Away from the endpoint (its upload)"},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
      }
    },
    "figures": {
      "type": "object",
      "description": "The access link's own contribution, one way. jitter_ms may not exceed delay_ms; loss_pct and burst_loss_pct exclude each other.",
      "additionalProperties": false,
      "properties": {
        "delay_ms": {"type": "number", "minimum": 0, "maximum": 10000},
        "jitter_ms": {"type": "number", "minimum": 0, "maximum": 10000},
        "loss_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "burst_loss_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "burst_length": {"type": "number", "minimum": 1},
        "rate_mbit": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "source": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "required": ["name", "licence"],
          "properties": {
            "name": {"type": "string"},
            "url": {"type": "string"},
            "date": {"type": "string"},
            "licence": {"type": "string", "description": "SPDX identifier, e.g. CC0-1.0, CC-BY-4.0, MIT"},
            "basis": {"type": "string", "description": "For an estimate: the reasoning that gives the figure"},
            "citation": {"type": "string"}
          }
        }
      ]
    }
  }
}
